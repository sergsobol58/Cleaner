    "Xcode recreates a simulator in seconds, but the apps installed in it and their data are gone. A runtime image has to be downloaded again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode recreates a simulator in seconds, but the apps installed in it and their data are gone. A runtime image has to be downloaded again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode відтворить симулятор за секунди, але встановлені в ньому програми та їхні дані зникнуть. Образ runtime доведеться завантажувати заново."
          }
        }
      }
    },
    "I understand this does not go to the Trash": {
      "extractionState": "manual",
